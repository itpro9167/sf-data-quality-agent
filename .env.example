# Copy to .env and fill in ONLY if you want real mode. Leave everything unset for mock mode
# (the default): a fake 200-account / 500-contact org and a canned "LLM" -- no credentials needed.
# Never commit your real .env (it is gitignored).

# --- Salesforce (real mode) -------------------------------------------------------------------
# All three of USERNAME / PASSWORD / SECURITY_TOKEN must be set for the real client to activate.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# "login" for production / developer orgs, "test" for sandboxes.
SF_DOMAIN=login

# --- Anthropic (real mode) --------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: override the model used by the proposal agent (default: claude-opus-5-5).
SFDQ_MODEL=

# --- App settings (all optional) --------------------------------------------------------------
# Force a mode regardless of which credentials exist: "mock" or "real".
SFDQ_MODE=
# Where the SQLite queue / audit log and the mock org snapshot live (default: ./.sfdq).
SFDQ_HOME=
# Name recorded in the audit log for approvals made in the dashboard (default: OS username).
SFDQ_REVIEWER=
# Path to a custom quality-rules YAML (default: the bundled src/sfdq/config/quality_rules.yaml).
SFDQ_RULES=
